# Adapted from moby/profiles 2ceae35d351c156cb5a8efc0fdc4a08cf94569d8
# apparmor/template.go; see vendor/LICENSE and README.md.
abi <abi/3.0>,
#include <tunables/global>

profile cheshi-codex-bwrap flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny network ax25,
  deny network ipx,
  deny network appletalk,
  deny network netrom,
  deny network rose,
  deny network econet,
  deny network atmsvc,
  deny network irda,
  deny network wanpipe,
  deny network isdn,
  deny network caif,
  deny network alg,
  deny network vsock,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (send,receive) peer=cheshi-codex-bwrap,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9/],[^1-9/][^0-9/],[^1-9s/][^0-9y/][^0-9s/],[^1-9/][^0-9/][^0-9/][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,

  # bwrap constructs its filesystem in a new user/mount namespace.
  # Kernel capability checks still prohibit mounting in the outer namespace.
  mount options=(rw,silent,rslave),
  mount options=(rw,silent,rprivate),
  mount options=(rw,bind),
  mount options=(rw,rbind),
  # Only the explicitly writable project root in Codex's inner namespace.
  mount options=(rw,nosuid,nodev,remount,bind,silent,relatime) -> /newroot/workspace/,
  mount options=(ro,nosuid,nodev,remount,bind,silent,relatime),
  mount options=(ro,nosuid,nodev,remount,bind,silent),
  mount options=(ro,nosuid,nodev,noexec,remount,bind,silent,relatime),
  mount fstype=tmpfs,
  mount fstype=proc,
  mount fstype=devpts,
  pivot_root,

  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,
  ptrace (trace,tracedby,read,readby) peer=cheshi-codex-bwrap,
}
