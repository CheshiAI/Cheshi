# Public build metadata. This file is the single source of truth for branding.
# Keep secrets in .env.local; renderer code never receives arbitrary env values.
APP_DISPLAY_NAME=Cheshi
APP_VERSION=0.0.5-preview
APP_BUILD_NUMBER=6
APP_INTERNAL_NAME=cheshi-desktop
APP_BUNDLE_ID=ai.cheshi.desktop
# New installations use Cheshi's own settings, chats, and CodeGraph storage.
APP_DATA_DIRECTORY=Cheshi
APP_PUBLISHER=Cheshi
