{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun"]
  },
  "include": [
    "../config/*.mts",
    "../forge.config.mts",
    "../scripts/*.mts",
    "backend/**/*.ts",
    "lib/**/*.mts",
    "bootstrap.mts",
    "main.mts",
    "workspace-runtime.mts",
    "preload.cts",
    "workspace-manager-preload.cts"
  ]
}
